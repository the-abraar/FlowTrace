# ─── Project FlowTrace — Environment Variables ────────────────────────────────────

# OpenAI
OPENAI_API_KEY=sk-...                     # Your OpenAI secret key
OPENAI_MODEL=gpt-4o                       # Model to use for FlowTrace agent

# Database
DATABASE_URL=sqlite+aiosqlite:///./flowtrace.db  # SQLite async URL

# MQTT Broker
MQTT_BROKER_HOST=localhost                # MQTT broker hostname
MQTT_BROKER_PORT=1883                     # MQTT broker port (default 1883)
MQTT_USERNAME=                            # Optional MQTT username
MQTT_PASSWORD=                            # Optional MQTT password
MQTT_TOPIC_PREFIX=flowtrace/nodes              # Topic prefix (appended with /+/readings)
MQTT_CLIENT_ID=flowtrace-backend               # MQTT client identifier

# API Server
API_HOST=0.0.0.0                          # Bind host
API_PORT=8000                             # Bind port
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173  # Allowed CORS origins

# Positioning Engine
POSITIONING_INTERVAL_SECONDS=2           # How often to run triangulation loop
AGENT_ANALYSIS_INTERVAL_SECONDS=30       # How often to run agent analysis

# BLE Path-Loss Model
BLE_TX_POWER=-59                          # Reference RSSI at 1 metre (dBm)
BLE_PATH_LOSS_EXPONENT=2.0               # Path-loss exponent (n), 2.0 = free space

# Venue
VENUE_ID=venue-001                        # Logical venue identifier
VENUE_NAME=Project FlowTrace Demo Venue        # Human-readable venue name

# Logging
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR

# Auth (see README). Writes are refused if INGEST_API_KEY is unset, unless DEBUG=1.
INGEST_API_KEY=                           # Required: sent as X-API-Key on POST /api/v1/readings
READ_API_KEY=                             # Optional: guards GETs and /ws (X-API-Key header or ?key=); open if unset
DEBUG=                                    # 1 = local dev: allow unauthenticated writes when INGEST_API_KEY is unset

# Tracking limits
DEVICE_TTL_SECONDS=600                    # Evict devices idle longer than this
MAX_TRACKED_DEVICES=5000                  # New devices beyond this are rejected (counted warning)
